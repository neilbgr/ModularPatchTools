<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- The one version of every binary (CLI, web app, libraries). A release is the tag v<Version>: the release workflow
       refuses a tag that doesn't match. The SDK appends the git commit to the informational version (1.0.0+<sha>). -->
  <PropertyGroup>
    <Version>1.5.0</Version>
    <Product>Modular Patch Tools</Product>
    <Authors>neilbgr</Authors>
    <Copyright>Copyright (c) 2026 neilbgr</Copyright>
  </PropertyGroup>

  <!-- The release date: the one CHANGELOG.md gives this version ("## [1.2.0] - 2026-11-03"), the section a release needs
       anyway. Empty while the version isn't dated there yet. Shown by the web app (ProductVersion.ReleaseDate). -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)CHANGELOG.md')">
    <ReleaseDate>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)CHANGELOG.md')), '(?&lt;=## \[$([System.Text.RegularExpressions.Regex]::Escape($(Version)))\] - )\d{4}-\d{2}-\d{2}').Value)</ReleaseDate>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ReleaseDate" Value="$(ReleaseDate)" />
  </ItemGroup>
</Project>
