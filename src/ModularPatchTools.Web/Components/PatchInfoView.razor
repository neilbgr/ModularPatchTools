@* What the patch file is and holds: format, Rack or Cardinal origin, every module with its role, diagnostics. *@

<div class="vpd-info">
    <dl>
        <dt>Format</dt><dd>@(Archive.WasArchive ? "tar+zstd archive" : "raw JSON")@(Archive.ExtraEntries.Count > 0 ? $", with {Archive.ExtraEntries.Count} extra files (module data)" : "")</dd>
        <dt>Origin</dt><dd>@ConvertedName.Describe(detection.Origin)</dd>
        <dt>Saved by</dt><dd>Rack @(Analysis.Patch.RackVersion ?? "?")</dd>
        <dt>Contents</dt><dd>@Analysis.Patch.Modules.Count modules, @Analysis.Patch.Cables.Count cables, @Analysis.Voices.Count voices</dd>
        @if (Analysis.Loops.Count > 0)
        {
            <dt title="Modules that feed each other: feedback, cross-modulation, or a module patched into itself">Feedback loops</dt>
            <dd><ul class="loops">@foreach (IReadOnlyList<long> loop in Analysis.Loops) { <li>@Analysis.DescribeLoop(loop)</li> }</ul></dd>
        }
        @if (detection.CardinalOnlyModules.Count > 0)
        {
            <dt>Cardinal only</dt><dd>@string.Join(", ", detection.CardinalOnlyModules.Select(m => m.Model).Distinct())</dd>
        }
        @if (detection.RackOnlyModules.Count > 0)
        {
            <dt>Rack Core only</dt><dd>@string.Join(", ", detection.RackOnlyModules.Select(m => m.Model).Distinct())</dd>
        }
    </dl>

    <div class="info-tools">
        @if (libraryKeys.Count > 0)
        {
            <a class="library-all" href="@VcvLibrary.ModulesUrl(libraryKeys)" target="_blank" rel="noopener"
               title="One VCV Library page with every module of this patch the Library publishes, to add the missing ones to your account (as Rack offers when a patch has missing modules)">Open the @libraryKeys.Count @(libraryKeys.Count == 1 ? "module" : "modules") in the VCV Library ↗</a>
        }
        <label class="info-option" title="Whether Cardinal can load each module. Also in the Diagram tab's Options.">
            <input type="checkbox" checked="@ShowCardinal" @onchange="e => ShowCardinalChanged.InvokeAsync((bool)e.Value!)" /> Cardinal compatibility
        </label>
    </div>
    <table>
        <thead><tr><th>Module</th><th>Plugin</th><th>Role</th><th>Does</th><th>Band</th>@if (ShowCardinal) {<th title="Can Cardinal load it? Official DISTRHO build, or only the neilbgr edition">Cardinal</th>}</tr></thead>
        <tbody>
            @foreach (ModuleType type in types)
            {
                AnalyzedModule first = type.Instances[0];
                bool open = expanded.Contains(type.Key);
                <tr class="role-@first.Role.ToString().ToLowerInvariant()">
                    <td><span class="chip"></span>
                        @if (VcvLibrary.IsListed(first.Plugin))
                        {
                            <a href="@VcvLibrary.PageUrl(type.Key)" target="_blank" rel="noopener" title="Open in the VCV Library">@type.Name</a>
                        }
                        else
                        {
                            @type.Name
                        }
                        @if (type.Instances.Count > 1)
                        {
                            <button class="instances" aria-expanded="@(open ? "true" : "false")" title="@(open ? "Hide" : "List") the @type.Instances.Count instances" @onclick="() => Toggle(type.Key)">@(open ? "▾" : "▸") × @type.Instances.Count</button>
                        }
                    </td>
                    <td>@first.Plugin</td>
                    <td>@SvgRenderer.RoleLabel(first.Role)</td>
                    <td>@ModuleFunctions.Label(first.Function)</td>
                    <td>@string.Join(", ", type.Instances.Select(m => m.Band).Distinct())</td>
                    @if (ShowCardinal)
                    {
                        CardinalSupport support = CardinalModules.Embedded.Check(first.Plugin, first.Module.Model);
                        <td class="cardinal-@support.Availability.ToString().ToLowerInvariant()">
                            @if (support.Availability == CardinalAvailability.NeilbgrEdition)
                            {
                                <a href="@CardinalModules.NeilbgrEditionUrl" target="_blank" rel="noopener" title="Bundled only with the neilbgr edition of Cardinal">neilbgr edition</a>
                            }
                            else
                            {
                                @CardinalModules.Label(support)
                            }
                        </td>
                    }
                </tr>
                @if (open)
                {
                    @foreach (AnalyzedModule instance in type.Instances)
                    {
                        <tr class="instance role-@instance.Role.ToString().ToLowerInvariant()">
                            <td>@instance.Title</td>
                            <td></td>
                            <td></td>
                            <td>@(instance.InsertOf is long host ? $"insert of {Analysis.Module(host).Title}" : "")</td>
                            <td>@instance.Band</td>
                            @if (ShowCardinal)
                            {
                                <td></td>
                            }
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public PatchAnalysis Analysis { get; set; } = default!;

    [Parameter, EditorRequired] public PatchArchive Archive { get; set; } = default!;

    /// <summary>Show whether Cardinal can load each module (a user preference, on by default).</summary>
    [Parameter] public bool ShowCardinal { get; set; } = true;

    [Parameter] public EventCallback<bool> ShowCardinalChanged { get; set; }

    private DetectionResult detection = default!;

    /// <summary>The modules of one kind (same plugin and model), one row with the count; unfolded, one row each.</summary>
    private sealed record ModuleType(string Key, string Name, IReadOnlyList<AnalyzedModule> Instances);

    private List<ModuleType> types = new List<ModuleType>();
    private List<string> libraryKeys = new List<string>();
    private readonly HashSet<string> expanded = new HashSet<string>(StringComparer.Ordinal);

    protected override void OnParametersSet()
    {
        detection = PatchDetector.Detect(Archive);
        types = Analysis.Modules
            .GroupBy(m => VcvLibrary.Key(m.Plugin, m.Module.Model))
            .Select(g => new ModuleType(g.Key, instanceNumber.Replace(g.First().Title, ""), g.OrderBy(m => m.Title, StringComparer.Ordinal).ToList()))
            .OrderBy(t => t.Instances.Min(m => m.Band)).ThenBy(t => t.Name, StringComparer.Ordinal)
            .ToList();
        // Every module of the file, docked expanders included: all of them may be missing from the user's Rack.
        libraryKeys = Analysis.Patch.Modules.Where(m => VcvLibrary.IsListed(m.Plugin)).Select(m => VcvLibrary.Key(m.Plugin, m.Model))
            .Distinct(StringComparer.Ordinal).ToList();
    }

    private void Toggle(string key)
    {
        if (!expanded.Remove(key))
        {
            expanded.Add(key);
        }
    }

    // "ADSR EG #2" is an "ADSR EG".
    private static readonly System.Text.RegularExpressions.Regex instanceNumber = new System.Text.RegularExpressions.Regex(@" #\d+$");
}
