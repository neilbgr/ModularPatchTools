@* What the patch file is and holds: format, Rack or Cardinal origin, every module with its role, diagnostics. *@

<div class="vpd-info">
    <dl>
        <dt>Format</dt><dd>@(Archive.WasArchive ? "tar+zstd archive" : "raw JSON")@(Archive.ExtraEntries.Count > 0 ? $", with {Archive.ExtraEntries.Count} extra files (module data)" : "")</dd>
        <dt>Origin</dt><dd>@ConvertedName.Describe(detection.Origin)</dd>
        <dt>Saved by</dt><dd>Rack @(Analysis.Patch.RackVersion ?? "?")</dd>
        <dt>Contents</dt><dd>@Analysis.Patch.Modules.Count modules, @Analysis.Patch.Cables.Count cables, @Analysis.Voices.Count voices</dd>
        @if (Analysis.Loops.Count > 0)
        {
            <dt title="Modules that feed each other: feedback, cross-modulation, or a module patched into itself">Feedback loops</dt>
            <dd><ul class="loops">@foreach (IReadOnlyList<long> loop in Analysis.Loops) { <li>@Analysis.DescribeLoop(loop)</li> }</ul></dd>
        }
        @if (detection.CardinalOnlyModules.Count > 0)
        {
            <dt>Cardinal only</dt><dd>@string.Join(", ", detection.CardinalOnlyModules.Select(m => m.Model).Distinct())</dd>
        }
        @if (detection.RackOnlyModules.Count > 0)
        {
            <dt>Rack Core only</dt><dd>@string.Join(", ", detection.RackOnlyModules.Select(m => m.Model).Distinct())</dd>
        }
    </dl>

    <label class="info-option" title="Whether Cardinal can load each module. Also in the Diagram tab's Options.">
        <input type="checkbox" checked="@ShowCardinal" @onchange="e => ShowCardinalChanged.InvokeAsync((bool)e.Value!)" /> Cardinal compatibility
    </label>
    <table>
        <thead><tr><th>Module</th><th>Plugin</th><th>Role</th><th>Does</th><th>Band</th>@if (ShowCardinal) {<th title="Can Cardinal load it? Official DISTRHO build, or only the neilbgr edition">Cardinal</th>}</tr></thead>
        <tbody>
            @foreach (AnalyzedModule module in Analysis.Modules.OrderBy(m => m.Band).ThenBy(m => m.Title, StringComparer.Ordinal))
            {
                <tr class="role-@module.Role.ToString().ToLowerInvariant()">
                    <td><span class="chip"></span>
                        @if (VcvLibrary.IsListed(module.Plugin))
                        {
                            <a href="@VcvLibrary.PageUrl(VcvLibrary.Key(module.Plugin, module.Module.Model))" target="_blank" rel="noopener" title="Open in the VCV Library">@module.Title</a>
                        }
                        else
                        {
                            @module.Title
                        }
                    </td>
                    <td>@module.Plugin</td>
                    <td>@SvgRenderer.RoleLabel(module.Role)</td>
                    <td>@ModuleFunctions.Label(module.Function)</td>
                    <td>@module.Band</td>
                    @if (ShowCardinal)
                    {
                        CardinalSupport support = CardinalModules.Embedded.Check(module.Plugin, module.Module.Model);
                        <td class="cardinal-@support.Availability.ToString().ToLowerInvariant()">
                            @if (support.Availability == CardinalAvailability.NeilbgrEdition)
                            {
                                <a href="@CardinalModules.NeilbgrEditionUrl" target="_blank" rel="noopener" title="Bundled only with the neilbgr edition of Cardinal">neilbgr edition</a>
                            }
                            else
                            {
                                @CardinalModules.Label(support)
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public PatchAnalysis Analysis { get; set; } = default!;

    [Parameter, EditorRequired] public PatchArchive Archive { get; set; } = default!;

    /// <summary>Show whether Cardinal can load each module (a user preference, on by default).</summary>
    [Parameter] public bool ShowCardinal { get; set; } = true;

    [Parameter] public EventCallback<bool> ShowCardinalChanged { get; set; }

    private DetectionResult detection = default!;

    protected override void OnParametersSet() => detection = PatchDetector.Detect(Archive);
}
